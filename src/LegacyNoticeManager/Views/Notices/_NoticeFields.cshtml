@model Notice
<div class="mb-3">
    <label asp-for="Title" class="form-label"></label>
    <input asp-for="Title" class="form-control" />
    <span asp-validation-for="Title" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Region" class="form-label"></label>
    <select asp-for="Region" class="form-select">
        <option value="">Select a region</option><option>North</option><option>South</option><option>Outer Reach</option>
    </select>
</div>
<div class="mb-3">
    <label asp-for="Severity" class="form-label"></label>
    <select asp-for="Severity" class="form-select"><option>Low</option><option>Medium</option><option>High</option></select>
</div>
<div class="mb-3">
    <label asp-for="EffectiveDate" class="form-label"></label>
    <input asp-for="EffectiveDate" type="date" class="form-control" />
</div>
<div class="mb-3">
    <label asp-for="ExpiryDate" class="form-label"></label>
    <input asp-for="ExpiryDate" type="date" class="form-control" />
    <span asp-validation-for="ExpiryDate" class="text-danger"></span>
</div>
<div class="form-check mb-3">
    <input asp-for="Emergency" class="form-check-input" />
    <label asp-for="Emergency" class="form-check-label"></label>
</div>
<div class="mb-3">
    <label asp-for="EmergencyExplanation" class="form-label"></label>
    <input asp-for="EmergencyExplanation" class="form-control" />
    <span asp-validation-for="EmergencyExplanation" class="text-danger"></span>
</div>
<input asp-for="Owner" type="hidden" />
