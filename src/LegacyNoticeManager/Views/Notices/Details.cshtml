@model Notice
@{
    ViewData["Title"] = "Notice details";
}
<h1>@Model.Title</h1>
<p><strong>Status:</strong> @Model.Status</p>
<dl class="row">
    <dt class="col-sm-3">Description</dt><dd class="col-sm-9">@Model.Description</dd>
    <dt class="col-sm-3">Region</dt><dd class="col-sm-9">@Model.Region</dd>
    <dt class="col-sm-3">Severity</dt><dd class="col-sm-9">@Model.Severity</dd>
    <dt class="col-sm-3">Effective</dt><dd class="col-sm-9">@Model.EffectiveDate.ToString("yyyy-MM-dd")</dd>
    <dt class="col-sm-3">Expiry</dt><dd class="col-sm-9">@Model.ExpiryDate.ToString("yyyy-MM-dd")</dd>
    <dt class="col-sm-3">Publication date</dt><dd class="col-sm-9">@Model.PublicationDate().ToString("yyyy-MM-dd")</dd>
</dl>
@if (Model.Status is "Draft" or "Rejected")
{
    <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
    <form asp-action="Approve" asp-route-id="@Model.Id" method="post" class="d-inline">
        <button class="btn btn-success" type="submit">Approve</button>
    </form>
    <form asp-action="Reject" asp-route-id="@Model.Id" method="post" class="d-inline">
        <label for="reason">Rejection reason</label><input id="reason" name="reason" />
        <button class="btn btn-warning" type="submit">Reject</button>
    </form>
}
@if (Model.Status == "Approved")
{
    <a class="btn btn-outline-success" asp-action="Export" asp-route-id="@Model.Id">Export summary</a>
}
<h2 class="h4 mt-4">Audit history</h2>
<ul>
@foreach (var record in Model.AuditRecords.OrderBy(a => a.OccurredAt))
{
    <li>@record.OccurredAt.ToString("u") — @record.Event (@record.Actor)</li>
}
</ul>
<a asp-action="Index">Back to register</a>
